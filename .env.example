# Environment Variables for MidWise

# Groq API Key (FREE - recommended)
# Get your free key at: https://console.groq.com
# No credit card required. 30K tokens/min, 14,400 requests/day
VITE_GROQ_API_KEY=

# OpenAI API Key (paid - optional fallback)
# Get your key at: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=

# Supabase (optional - app works in demo mode without it)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
